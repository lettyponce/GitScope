<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GitScope" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.GitScope.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F6F8FA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_gitscope</item>
        <item name="postSplashScreenTheme">@style/Theme.GitScope</item>
    </style>
</resources>
